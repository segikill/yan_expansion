{
  "manifest_version": 3,
  "name": "Maps Export Overlay: Yandex, Google, 2GIS",
  "version": "1.12.3",
  "description": "Сбор объектов с карт и досбор подробных данных по URL в фоновых вкладках.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.yandex.ru/maps/*",
    "https://*.ya.ru/maps/*",
    "https://*.yandex.com/maps/*",
    "https://*.google.com/maps/*",
    "https://maps.google.com/*",
    "https://*.2gis.ru/*",
    "https://*.2gis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.yandex.ru/maps/*",
        "https://*.ya.ru/maps/*",
        "https://*.yandex.com/maps/*",
        "https://*.2gis.ru/*",
        "https://*.2gis.com/*"
      ],
      "exclude_matches": [
        "https://*.yandex.ru/maps/org/*",
        "https://*.ya.ru/maps/org/*",
        "https://*.yandex.com/maps/org/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "content.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.yandex.ru/maps/org/*",
        "https://*.ya.ru/maps/org/*",
        "https://*.yandex.com/maps/org/*"
      ],
      "js": [
        "detail_parser.js",
        "detail_content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.2gis.ru/*",
        "https://*.2gis.com/*"
      ],
      "js": [
        "two_gis_detail_parser.js",
        "two_gis_detail_content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "xlsx.full.min.js",
        "google_content.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sniffer.js",
        "interceptor.js",
        "two_gis_detail_bridge.js"
      ],
      "matches": [
        "https://*.yandex.ru/*",
        "https://*.ya.ru/*",
        "https://*.yandex.com/*",
        "https://*.2gis.ru/*",
        "https://*.2gis.com/*"
      ]
    }
  ]
}
